# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Docker: postgresql://kartbook_user:kartbook_pass@db:5432/kartbook
# Local:  postgresql://kartbook_user:kartbook_pass@localhost:5432/kartbook
# Render: paste the "Internal Database URL" from your Render Postgres service
DATABASE_URL=postgresql://kartbook_user:kartbook_pass@localhost:5432/kartbook

# ── Security ──────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_random_32_char_hex_string

# JWT signing algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# JWT token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins.
# Development: ["http://localhost:5173"]
# Production:  ["https://your-frontend.onrender.com"]
CORS_ORIGINS=["http://localhost:5173"]

# ── Yandex Maps (optional) ────────────────────────────────────────────────────
# Used only for documentation/reference. Distance calculation runs on the frontend.
# Obtain a key at https://developer.tech.yandex.ru/
YANDEX_MAPS_API_KEY=YOUR_YANDEX_MAPS_API_KEY_HERE
