# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of the backend service (no trailing slash).
# Development: http://localhost:8000
# Production:  https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# ── Yandex Maps ───────────────────────────────────────────────────────────────
# API key for Yandex Static Maps (kartodrome map widget) and Routing API (driving distances).
# Without a key the map falls back to a clickable placeholder and distances use
# the straight-line haversine formula (prefixed with "~").
# Obtain a key at: https://developer.tech.yandex.ru/
# Required APIs to enable for this key:
#   - Static API (Статические карты)
#   - Routing API / Router (Маршрутизатор) — for driving distances
VITE_YANDEX_MAPS_API_KEY=YOUR_YANDEX_MAPS_API_KEY_HERE
